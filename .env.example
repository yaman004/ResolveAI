# ---- Copy this file to `.env` in the repository root and edit the values. ----
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB: local instance or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/resolveai

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=7

# URL the React app is served from (used for CORS and invitation links)
CLIENT_URL=http://localhost:5173

# Cookie settings. Use COOKIE_SAMESITE=none (requires HTTPS) only if client and API are on different sites.
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# ---- AI provider (any OpenAI-compatible chat-completions API) ----
# Leave AI_API_KEY empty to run without AI; the app shows a setup message and everything else works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000

# ---- Billing ----
# No payment provider is wired in. When true, an Owner can switch plans without payment (dev/demo only).
# Defaults to true in development and false in production.
ALLOW_PLAN_SWITCH_WITHOUT_PAYMENT=

# ---- Production only ----
# Serve the built React app from the Express server (after `npm run build`)
SERVE_CLIENT=false
